---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TagFilter from '../../components/TagFilter.astro';
import { discography, allTags } from '../../../data/discography.js';
---

<BaseLayout title="Discography">
  <PageHero title="Discography" subtitle="楽曲一覧" />

  <div class="max-w-6xl mx-auto px-4 py-16">
    <TagFilter tags={allTags} total={discography.length} />

    <!-- カードスクロールエリア -->
    <div class="card-scroll-area">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {discography.map(track => (
          <a
            href={`/discography/${track.id}`}
            class="card bg-base-200 border border-base-300 shadow hover:shadow-xl transition-all hover:-translate-y-1 group"
            data-filter-card
            data-tags={track.tags.join(',')}
          >
            <figure class="aspect-video bg-base-300 overflow-hidden rounded-t-2xl">
              {track.youtube ? (
                <img
                  src={`https://img.youtube.com/vi/${track.youtube}/hqdefault.jpg`}
                  alt={track.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              ) : track.thumbnail ? (
                <img
                  src={track.thumbnail}
                  alt={track.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-5xl bg-gradient-to-br from-primary/20 to-secondary/20">💿</div>
              )}
            </figure>
            <div class="card-body p-4">
              <h2 class="font-display font-semibold text-lg group-hover:text-primary transition-colors leading-snug">
                {track.title}
              </h2>
              <span class="text-xs text-base-content/40 mt-1">{track.date}</span>
              <div class="flex flex-wrap gap-1 mt-2">
                {track.tags.map(tag => (
                  <span class="badge badge-outline badge-sm text-xs">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- 0件メッセージ -->
      <div data-filter-empty class="hidden text-center py-20 text-base-content/40">
        <p class="text-4xl mb-4">🔍</p>
        <p>該当する楽曲が見つかりませんでした</p>
        <button data-filter-reset class="btn btn-sm btn-outline mt-4">タグをリセット</button>
      </div>
    </div>
  </div>
</BaseLayout>
