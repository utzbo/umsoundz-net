---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TagFilter from '../../components/TagFilter.astro';
import { works, allWorkTags } from '../../../data/works.js';
---

<BaseLayout title="Works">
  <PageHero title="Works" subtitle="制作・提供実績" />

  <div class="max-w-6xl mx-auto px-4 py-16">
    <TagFilter tags={allWorkTags} total={works.length} />

    <!-- カードスクロールエリア -->
    <div class="card-scroll-area">
      <div class="flex flex-col gap-4">
        {works.map(work => (
          <a
            href={`/works/${work.id}`}
            class="card card-side bg-base-200 border border-base-300 shadow hover:shadow-lg transition-all hover:-translate-y-0.5 group"
            data-filter-card
            data-tags={work.tags.join(',')}
          >
            {(work.thumbnail || work.youtube) && (
              <figure class="w-32 md:w-48 flex-shrink-0 overflow-hidden rounded-l-2xl bg-base-300">
                <img src={work.thumbnail || `https://img.youtube.com/vi/${work.youtube}/hqdefault.jpg`} alt={work.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              </figure>
            )}
            <div class="card-body p-5 min-w-0">
              <span class="text-xs text-base-content/40 mb-1">{work.date}</span>
              <h2 class="font-display font-semibold text-xl group-hover:text-primary transition-colors">
                {work.title}
              </h2>
              <p class="text-sm text-base-content/60 truncate">{work.description}</p>
              <div class="flex flex-wrap gap-1 mt-2">
                {work.tags.map(tag => (
                  <span class="badge badge-outline badge-sm text-xs">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- 0件メッセージ -->
      <div data-filter-empty class="hidden text-center py-20 text-base-content/40">
        <p class="text-4xl mb-4">🔍</p>
        <p>該当する実績が見つかりませんでした</p>
        <button data-filter-reset class="btn btn-sm btn-outline mt-4">タグをリセット</button>
      </div>
    </div>
  </div>
</BaseLayout>
